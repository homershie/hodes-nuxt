# Google reCAPTCHA v3 設定
# 請到 https://www.google.com/recaptcha/admin 註冊並取得金鑰

# 開發模式
NODE_ENV=development

# 網站金鑰 (Site Key) - 用於前端
# 在 Nuxt 中，加上 NUXT_PUBLIC_ 前綴的環境變數可以在前端使用
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here

# 密鑰 (Secret Key) - 用於後端驗證 reCAPTCHA token
# 注意：這個密鑰只能在後端使用，絕對不能暴露在前端程式碼中
RECAPTCHA_SECRET_KEY=your_secret_key_here

# Resend Email API 設定
# 請到 https://resend.com 註冊並取得 API Key
RESEND_API_KEY=your_resend_api_key_here

# 收件人 Email (寫死以防止濫用)
TO_EMAIL=your_email@example.com

# 版本號設定
NUXT_PUBLIC_APP_VERSION=v2.0.2
