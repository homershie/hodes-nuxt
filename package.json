{
  "name": "hodes-nuxt",
  "version": "1.0.0",
  "description": "Homer Shie 的個人作品集網站 - Nuxt 版本",
  "author": "Homer Shie <homerxworkshop@gmail.com>",
  "type": "module",
  "private": true,
  "homepage": "https://homershie.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/homershie/hodes-nuxt.git"
  },
  "keywords": [
    "nuxt3",
    "portfolio",
    "personal-website",
    "ui-ux-design",
    "frontend-development",
    "typescript",
    "scss",
    "ssr",
    "responsive-design",
    "creative-portfolio"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && patch-package",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "generate:images": "node scripts/generateImageData.js",
    "build:with-images": "npm run generate:images && npm run build",
    "test:nuxt": "vitest --config vite.config.ts",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint:check && npm run format:check && npm run test:run"
  },
  "dependencies": {
    "@nuxt/content": "^3.7.1",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/icon": "^2.1.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^4.0.1",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@pinia/nuxt": "^0.5.5",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "better-sqlite3": "^12.4.1",
    "gsap": "^3.13.0",
    "masonry-layout": "^4.2.2",
    "nuxt": "^4.1.2",
    "nuxt-gtag": "^4.0.0",
    "pinia": "^3.0.1",
    "resend": "^6.2.2",
    "sass": "^1.89.1",
    "unist-util-visit": "^5.0.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.22",
    "vue-recaptcha-v3": "^2.0.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@eslint/js": "^8.56.0",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/test-utils": "^3.13.0",
    "@nuxtjs/mdc": "^0.18.0",
    "@nuxtjs/seo": "^3.2.2",
    "@types/node": "^24.6.2",
    "@vitest/coverage-v8": "^3.2.3",
    "@vitest/ui": "^3.2.3",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^14.0.0",
    "@vueuse/nuxt": "^14.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "prettier": "3.5.3",
    "sass-embedded": "^1.93.2",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3",
    "wrangler": "^4.45.3"
  }
}
